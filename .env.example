# ─────────────────────────────────────────────────────────────────────────────
#  Fenora Content Desk — environment variables
#
#  Locally:  cp .env.example .env.local   (then fill it in)
#  Vercel:   Project → Settings → Environment Variables (then redeploy)
#
#  Only DESK_PASSWORD is required to open the desk. Everything else is an
#  account connection — add them as you connect each platform, or connect from
#  the Settings page instead (which stores tokens in your database).
# ─────────────────────────────────────────────────────────────────────────────

# The password that protects the desk. Without it, the desk stays locked.
DESK_PASSWORD=

# Optional. Encrypts the access tokens stored in your database, and signs the
# login cookie. Any long random string. See README → "Secrets".
DESK_SECRET=

# Optional. The public address of this deployment, used for the image links
# Instagram and Facebook fetch. Vercel provides this automatically; set it if
# you use a custom domain that Vercel does not know about.
# PUBLIC_BASE_URL=https://desk.fenora.pro

# ── Storage (one of these — both are one click in Vercel → Storage) ──────────
# Keeps your connections, schedule and posted-log between deploys.
# Upstash Redis / Vercel KV (recommended):
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# …or Postgres / Neon / Supabase:
# DATABASE_URL=

# ── Meta: Instagram + Facebook (Settings → Connect handles the OAuth) ───────
# Create an app at developers.facebook.com, add the "Facebook Login" and
# "Instagram" products, then paste the app credentials here.
# META_APP_ID=
# META_APP_SECRET=
# Optional: pin a Graph API version. The desk fails over automatically.
# META_GRAPH_VERSION=v23.0
# Optional: skip OAuth entirely by pasting a long-lived Page token.
# META_PAGE_ID=
# META_PAGE_TOKEN=
# IG_USER_ID=

# ── LinkedIn (Settings → Connect handles the OAuth) ────────────────────────
# Create an app at linkedin.com/developers/apps with the
# "Share on LinkedIn" + "Sign In with LinkedIn" products.
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# LINKEDIN_VERSION=202601
# Optional: skip OAuth entirely by pasting a token.
# LINKEDIN_ACCESS_TOKEN=
# LINKEDIN_ORG_URN=urn:li:organization:12345678

# ── Auto-publishing (optional) ──────────────────────────────────────────────
# Vercel sends this as a Bearer token to /api/cron. Set it, then turn on
# "Publish automatically" in Settings.
# CRON_SECRET=

# Emergency: run the desk with no password at all. Anyone with the URL can
# then post to your accounts. Do not use this on a public deployment.
# ALLOW_PUBLIC_DESK=1
