# ── Secrets & credentials — never commit ────────────────────────────────────
.env
.env.local
.env*.local
config.json
*.token

# ── Local desk state (used when no database is configured) ──────────────────
.data/

# ── Next.js ────────────────────────────────────────────────────────────────
node_modules/
.next/
.next-*/
out/
next-env.d.ts
.vercel
*.tsbuildinfo

# ── Image renderer output ──────────────────────────────────────────────────
# render/png/ is the print-master set: reproducible, not committed.
# public/media/ IS committed on purpose — Instagram can only post from a public
# URL, so the upload-ready JPEGs ship with the site.
render/png/
fenora-images.zip

# ── Python ─────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
.venv/
venv/

# ── Editors / OS ───────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
